DB_HOST=your-cloud-db-host
DB_PORT=3306
DB_NAME=cloudtajo
DB_USER=cloudtajo_app
DB_PASSWORD=change-me

# Access token signing secret
AUTH_TOKEN_SECRET=change-me-to-a-long-random-secret

# Naver Cloud Object Storage (S3 compatible)
NCP_ACCESS_KEY=change-me
NCP_SECRET_KEY=change-me
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_REGION=kr-standard
NCP_OBJECT_STORAGE_BUCKET=your-bucket

# CLOVA OCR
CLOVA_OCR_API_URL=https://your-clova-ocr-endpoint
CLOVA_OCR_SECRET=change-me
